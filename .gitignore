# Media and generated content (import separately, never commit)
uploads/
upgrade/
backup-db/
cache/
backups/
wflogs/

# Default WordPress themes (removed from Local; ignore if reinstalled by core update)
themes/twentytwenty*/
themes/twentytwentyfive/
themes/twentytwentyfour/
themes/twentytwentythree/

# Third-party plugins — present locally after production copy, not tracked in Git.
# Only TwinTack custom plugins (plugins/twintack-*) are version-controlled.
# Versions documented in docs/PLUGIN_INVENTORY.md
plugins/*
!plugins/index.php
!plugins/twintack-*/

# Secrets and environment
.env
.env.*
!.env.example
wp-config.php
wp-config-*.php

# Dependencies
node_modules/
vendor/

# IDE and OS
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
._*
Thumbs.db

# Build artifacts
*.css.map
*.sass-cache/
dist/
build/

# Logs and temp
*.log
debug.log
error_log
*.swp
*.swo
*~
